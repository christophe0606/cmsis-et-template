# Python
.venv/
__pycache__/
*.pyc
*.bak

# Temporary reference files used while adapting the Zephyr template
Chris/

# Generated ExecuTorch programs are normally reproducible build artifacts.
*.pte
# Zephyr examples use committed, target-validated programs. Keep named inputs,
# but continue to ignore obsolete output from the former single-model flow.
!zephyr-*/ai_layer/*.pte
zephyr-*/ai_layer/model.pte

# CMSIS-Toolbox build outputs. Keep configurable RTE content, but ignore the
# per-context inventory and pre-include headers regenerated by CMSIS-Toolbox.
**/RTE/_*/RTE_Components.h
**/RTE/_*/Pre_Include_*.h
out/
tmp/
*.cbuild.yml
*.cbuild-idx.yml
*.cbuild-run.yml
*.cbuild-set.yml
*.cbuild-pack.yml
*.cbuild-mlops.yml
*.update@*
.cmd.jlink
tools-environment.yml
*.cprj

# SDS and FVP generated files
*.[sS][dD][sS]
sdsio.log

# Compiler-generated dependencies
*.d
# CMSIS Solution drop-ins are source files, despite the directory suffix.
!.vscode.d/

# Object files
*.o
*.ko
*.obj

# Linker output
*.elf
*.ilk
*.map
*.exp

# Precompiled headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects
*.dll
*.so
*.so.*
*.dylib

# Executables and images
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb
*.dwo

# Regenerated by the CMSIS Solution / clangd extensions on every build, with
# absolute paths for the machine that built it -- so it cannot be committed in
# a portable form. Not committing it loses nothing: it is generated for you.
.clangd

# FVP output captured by CI and by the manual run in the README
fvp_stdout.log

# Local validation reports and build logs
/test-logs/

# Editor config. The CMSIS Solution extension regenerates tasks.json,
# settings.json, cmsis.json and launch.json; only the macOS FVP wiring is kept:
# the model shim + its Dockerfile, and launch.json.mac, an Arm-FVP launch
# config that waits for the model in Docker (see the comment in it). The
# leading negation overrides a global excludes file that ignores every .vscode
# directory.
!.vscode/
.vscode/*
!.vscode/fvp.sh
!.vscode/fvp.Dockerfile
!.vscode/launch.json.mac
reproducer/
